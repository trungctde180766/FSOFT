# ==============================================================================
# ApexCore Environment Variables
# ==============================================================================

# Cổng khởi chạy máy chủ Local (Mặc định: 3000)
PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# 1. Google Gemini AI Keys (Phục vụ xoay vòng và dự phòng rate-limit)
# ──────────────────────────────────────────────────────────────────────────────
# Danh sách API keys cách nhau bởi dấu phẩy:
GEMINI_API_KEYS=your_gemini_api_key_1_here,your_gemini_api_key_2_here
# Hoặc key đơn:
# GEMINI_API_KEY=your_single_gemini_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# 2. Database MongoDB (Atlas Cloud)
# ──────────────────────────────────────────────────────────────────────────────
# Chuỗi kết nối MongoDB Atlas (mongodb+srv://<username>:<password>@cluster.mongodb.net/...)
# Nếu để trống ở Local, hệ thống sẽ tự động fallback sang kho lưu trữ local file an toàn.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=apexcore_db

# ──────────────────────────────────────────────────────────────────────────────
# 3. Authentication & Security (JWT)
# ──────────────────────────────────────────────────────────────────────────────
# Khóa bí mật ký JWT Token (Nên thay đổi chuỗi ngẫu nhiên dài khi lên Production)
JWT_SECRET=apexcore_super_secret_jwt_key_2026_x89!master

# Danh sách Email mặc định được cấp quyền Quản trị viên (Admin) (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=admin@apexcore.com,your_email@gmail.com
