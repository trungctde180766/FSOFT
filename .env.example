# ==============================================================================
# ApexCore Environment Variables
# ==============================================================================
# Hướng dẫn cấu hình API Key cho Google Gemini AI:
#
# Cách 1 (Khuyên dùng cho Vercel):
# Nhập danh sách các API key cách nhau bởi dấu phẩy (hoặc xuống dòng):
# GEMINI_API_KEYS="AIzaSy...,AIzaSy...,AIzaSy..."
#
# Cách 2: Từng key riêng biệt (Hỗ trợ xoay vòng tối đa 5 keys):
# GEMINI_API_KEY_1="AIzaSy..."
# GEMINI_API_KEY_2="AIzaSy..."
# GEMINI_API_KEY_3="AIzaSy..."
#
# Cách 3 (Dành cho Local dev):
# Bạn có thể sao chép file này thành .env và dán thẳng các API key vào,
# mỗi dòng một key (không cần tên biến).
# ==============================================================================

# Cổng khởi chạy máy chủ Local (Mặc định: 3000)
PORT=3000

# Danh sách Google Gemini API Keys (phục vụ xoay vòng và dự phòng rate-limit)
GEMINI_API_KEYS=your_gemini_api_key_1_here,your_gemini_api_key_2_here

# Hoặc key đơn:
# GEMINI_API_KEY=your_single_gemini_api_key_here
